# authproPlus 运行配置示例
# 复制为部署环境的 .env 文件后按实际地址修改。

PORT=19127
AUTO_PRO_DATA_DIR=/opt/authproplus/data
AUTO_PRO_FRONTEND_DIR=/opt/authproplus/frontend/current

# 数据库
AUTO_PRO_DB_HOST=127.0.0.1
AUTO_PRO_DB_PORT=3306
AUTO_PRO_DB_NAME=auth_pro
AUTO_PRO_DB_USER=authpro
AUTO_PRO_DB_PASSWORD=change-me

# 广告服务：必须返回兼容格式的 JSON。
# 接口会收到 ?position=home-banner、sidebar 或 popup。
AUTO_PRO_ADVERTISEMENT_URL=https://plus.example.com/api/v1/public/advertisements
AUTO_PRO_ADVERTISEMENT_TIMEOUT=5s
AUTO_PRO_ADVERTISEMENT_CACHE_TTL=5m
AUTO_PRO_ADVERTISEMENT_STALE_TTL=1h

# authproPlus 自身在线更新清单。
# 可使用自建 HTTPS、GitHub Release 镜像或其他兼容源。
AUTO_PRO_UPDATE_URL=https://plus.example.com/releases/latest.json

# 服务名称和可选公共地址
AUTO_PRO_SERVICE_NAME=authproPlus
AUTO_PRO_PUBLIC_BASE_URL=https://plus.example.com

# 如果使用本地包存储，可配置以下目录；生产环境建议使用私有 OSS/S3。
AUTO_PRO_STORAGE_PROVIDER=local
AUTO_PRO_STORAGE_DIR=/opt/authproplus/packages

# 软件源插件/首页模板仍使用现有数据库后台管理和 index.json 格式。
# 软件源地址不是通过环境变量固定配置，而是在后台“插件中心/软件源管理”添加。
